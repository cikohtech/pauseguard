# Copy to .env (make setup does this). Never commit .env.
PRODUCT_NAME=PauseGuard
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global            # Vertex AI location for Gemini (3.8 Flash is served on global / multi-region)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=gemini-3.8-flash           # GA 2 Sep 2026, verified 10 Oct 2026 (2.5 Flash retires 16 Oct 2026)
GEMINI_THINKING_LEVEL=LOW               # LOW | MEDIUM | HIGH (3.8 Flash rejects MINIMAL)
GEMINI_MEDIA_RESOLUTION=MEDIUM          # evidence images/PDF pages: LOW | MEDIUM | HIGH | DEFAULT
DATA_REGION=asia-southeast1
DATA_BACKEND=sqlite                     # sqlite | bigquery
SQLITE_PATH=./data/seed/pauseguard.db   # relative to the repo root
BQ_DATASET=pauseguard
STATE_BACKEND=firestore                 # firestore | memory (memory: no emulator, nothing persists)
FIRESTORE_EMULATOR_HOST=localhost:8080  # local only; the emulator project is demo-pauseguard
EVIDENCE_BUCKET=your-project-pauseguard-evidence
# UPLOAD_BACKEND=local                  # local | gcs; unset: gcs on Cloud Run, local elsewhere (local is refused on Cloud Run)
LOCAL_UPLOADS_DIR=./.local_uploads      # local evidence uploads (git-ignored), relative to the repo root
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated
AGENT_TIMEOUT_SECONDS=12               # customer-facing budget (evidence + intel + explainer); over it → AMBER + review
EXPLAINER_BUDGET_SECONDS=4              # the explainer's own cap; slower → the reviewed static message for the verdict
CASEFILE_TIMEOUT_SECONDS=25             # analyst-facing budget (case file ∥ web search), after the verdict
INTEL_MAX_SEARCHES=2                    # Google Search calls per check
EVIDENCE_HEDGE_AFTER_SECONDS=6          # tail latency: a second identical evidence request after 6 s, first answer wins (0 = off)
# Fusion thresholds (AGENTS_SPEC §4) are frozen before the test split runs; defaults live in app/config.py
FUSION_RED_MIN_AMOUNT=1000              # SGD; a scam pattern without a hard-stop signal is AMBER below this (0 = off)
AUTH_DISABLED=true                      # local dev only; the API refuses to start with this on Cloud Run
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099  # with AUTH_DISABLED=false: accept the Auth emulator's ID tokens locally
ADMIN_RESET_TOKEN=local-dev-only        # Secret Manager (admin-reset-token) in cloud
RATE_LIMIT_CHECKS=30/hour               # POST /checks per client IP
RATE_LIMIT_CHECKS_PER_CUSTOMER=120/hour # POST /checks per customer_id (judges share the 3 personas)
GEMINI_PRICE_IN_USD_PER_MTOK=0.75      # /metrics cost per check, USD per 1M tokens: copy from eval/pricing.yaml
GEMINI_PRICE_OUT_USD_PER_MTOK=3.75     # (published Vertex AI price, source + date there; never guess)
LOG_LEVEL=INFO
# web (Vite); see web/.env.example
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_CONFIG_JSON={}
