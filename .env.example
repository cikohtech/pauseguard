# Copy to .env (make setup does this). Never commit .env.
PRODUCT_NAME=PauseGuard
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global            # Vertex AI location for Gemini (3.8 Flash is served on global / multi-region)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=gemini-3.8-flash           # GA 2 Sep 2026, verified 10 Oct 2026 (2.5 Flash retires 16 Oct 2026)
GEMINI_THINKING_LEVEL=LOW               # LOW | MEDIUM | HIGH (3.8 Flash rejects MINIMAL)
DATA_REGION=asia-southeast1
DATA_BACKEND=sqlite                     # sqlite | bigquery
SQLITE_PATH=./data/seed/pauseguard.db   # relative to the repo root
BQ_DATASET=pauseguard
STATE_BACKEND=firestore                 # firestore | memory (memory: no emulator, nothing persists)
FIRESTORE_EMULATOR_HOST=localhost:8080  # local only; the emulator project is demo-pauseguard
EVIDENCE_BUCKET=your-project-pauseguard-evidence
ALLOWED_ORIGINS=http://localhost:5173   # comma-separated
AGENT_TIMEOUT_SECONDS=12
AUTH_DISABLED=true                      # local dev only; the API refuses to start with this on Cloud Run
ADMIN_RESET_TOKEN=local-dev-only        # Secret Manager (admin-reset-token) in cloud
RATE_LIMIT_CHECKS=30/hour
LOG_LEVEL=INFO
# web (Vite); see web/.env.example
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_CONFIG_JSON={}
